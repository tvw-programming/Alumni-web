# Fast local feedback only. CI (.github/workflows/ci-deploy.yml) stays
# authoritative because Git hooks can be skipped with `git commit --no-verify`
# and are not installed until someone runs `pnpm install`.
#
# The repo holds two apps — frontend/react and frontend/angular — so this hook
# checks only the ones with staged changes. Committing to one app should not
# pay for building the other.
#
# Husky installs this hook from frontend/react (see that package.json's
# `prepare` script), but Git runs it from the repository root, so every command
# below changes directory first.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
root=$(git rev-parse --show-toplevel)

react_changed=""
angular_changed=""

case "$staged" in
  *frontend/react/*) react_changed=1 ;;
esac
case "$staged" in
  *frontend/angular/*) angular_changed=1 ;;
esac

# A change outside both apps (Makefile, compose, workflows, docs) still deserves
# the React checks, since that app is what CI builds and deploys today.
if [ -z "$react_changed" ] && [ -z "$angular_changed" ]; then
  react_changed=1
fi

if [ -n "$react_changed" ]; then
  echo "▸ react"
  cd "$root/frontend/react" || exit 1

  # ESLint --fix + Prettier, on staged files only.
  pnpm exec lint-staged || exit 1

  # Project-wide: a type error is rarely confined to the files you staged.
  pnpm typecheck || exit 1

  # Cheap today (~5s). If the suite grows, drop this line and let CI own it —
  # a slow hook is a hook people start bypassing.
  pnpm test || exit 1
fi

if [ -n "$angular_changed" ]; then
  echo "▸ angular"
  cd "$root/frontend/angular" || exit 1

  # The Angular CLI needs a newer Node than this machine's default (see
  # .node-version). Rather than block a commit over a local toolchain gap, warn
  # and let CI be the backstop — the alternative is a hook people bypass.
  if ! pnpm exec ng version >/dev/null 2>&1; then
    echo "  ! skipped: the Angular CLI could not run under $(node -v)."
    echo "    It needs the version pinned in frontend/angular/.node-version."
  else
    # `ng test` compiles the app and its specs, so this covers type errors,
    # template errors and unit tests in one pass.
    pnpm exec ng test --watch=false || exit 1
  fi
fi
