<?xml version="1.0" encoding="UTF-8"?>
<!--
  Four dependencies, on purpose.

  web    - the HTTP layer
  jdbc   - JdbcTemplate, so SQL stays visible instead of hiding behind entities
  crypto - BCryptPasswordEncoder alone; the full Security starter would bring a
           filter chain this app deliberately does not have
  pgsql  - the driver

  There is no JWT library: signing an HS256 token is fifteen lines of javax.crypto
  (see Jwt.java), and one fewer dependency is the point of this app.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.idol</groupId>
  <artifactId>api-spring</artifactId>
  <version>1.0.0</version>
  <name>api-spring</name>
  <description>Simplest Spring Boot port of the Go Fiber API</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
