{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    // vite.config.ts imports node:fs and node:url. Without these types they
    // resolve to `any`, and every call through them is an unsafe-* lint
    // finding that says nothing about the code.
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
