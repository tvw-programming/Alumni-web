{
  "fields": [
    {
      "name": "productId",
      "label": "Product ID",
      "type": "text",
      "placeholder": "Enter product ID",
      "required": true,
      "validation": {
        "minLength": 3,
        "maxLength": 15
      }
    },
    {
      "name": "productName",
      "label": "Product Name",
      "type": "text",
      "placeholder": "Enter product name",
      "required": true,
      "validation": {
        "minLength": 2,
        "maxLength": 100
      }
    },
    {
      "name": "description",
      "label": "Product Description",
      "type": "textarea",
      "placeholder": "Enter product description",
      "required": true,
      "validation": {
        "maxLength": 500
      },
      "rows": 5,
      "debounceMs": 400,
      "customOverride": {
        "styling": {
          "backgroundColor": "#f3e5f5",
          "borderRadius": "8px",
          "padding": "8px",
          "border": "2px solid #9C27B0"
        },
        "htmlAttributes": {
          "data-testid": "product-description-field"
        },
        "validation": "descriptionValidation",
        "onCustomChange": "handleDescriptionChange",
        "onCustomBlur": "handleDescriptionBlur"
      }
    },
    {
      "name": "price",
      "label": "Price",
      "type": "number",
      "placeholder": "Enter price",
      "required": true
    },
    {
      "name": "rating",
      "label": "Product Rating",
      "type": "rating",
      "required": true,
      "max": 5,
      "precision": 1
    },
    {
      "name": "productImage",
      "label": "Product Image",
      "type": "file",
      "required": true,
      "file": {
        "accept": ["image/png", "image/jpeg", "image/webp"],
        "multiple": false,
        "maxFileSizeMb": 2,
        "showPreview": true,
        "dropzone": true,
        "helperText": "One product photo. PNG, JPEG or WebP, up to 2 MB."
      }
    },
    {
      "name": "productDocuments",
      "label": "Supporting Documents",
      "type": "file",
      "required": false,
      "file": {
        "accept": [".pdf", ".doc", ".docx", "text/plain"],
        "multiple": true,
        "maxFiles": 5,
        "maxFileSizeMb": 5,
        "maxTotalSizeMb": 15,
        "showPreview": false,
        "dropzone": true,
        "helperText": "Optional: spec sheets, manuals or certificates."
      }
    },
    {
      "name": "comments",
      "label": "Comments",
      "type": "textarea",
      "placeholder": "Enter comment",
      "required": false,
      "rows": 4,
      "debounceMs": 300
    },
    {
      "name": "releaseDate",
      "label": "Release Date",
      "type": "date",
      "required": true
    },
    {
      "name": "supportEmail",
      "label": "Support Email",
      "type": "email",
      "placeholder": "support@example.com",
      "required": false
    },
    {
      "name": "supportPhone",
      "label": "Support Phone",
      "type": "tel",
      "placeholder": "+1 555 0100",
      "required": false
    },
    {
      "name": "productUrl",
      "label": "Product Page",
      "type": "url",
      "placeholder": "https://example.com/product",
      "required": false
    },
    {
      "name": "themeColor",
      "label": "Theme Colour",
      "type": "color",
      "required": false
    },
    {
      "name": "condition",
      "label": "Condition",
      "type": "radio",
      "required": true,
      "choice": { "row": true },
      "options": [
        { "value": "new", "label": "New" },
        { "value": "refurbished", "label": "Refurbished" },
        { "value": "used", "label": "Used" }
      ]
    },
    {
      "name": "availability",
      "label": "Availability",
      "type": "toggle",
      "required": false,
      "options": [
        { "value": "inStock", "label": "In stock" },
        { "value": "preorder", "label": "Pre-order" },
        { "value": "discontinued", "label": "Discontinued" }
      ]
    },
    {
      "name": "tags",
      "label": "Tags",
      "type": "autocomplete",
      "placeholder": "Type to search or add your own",
      "required": false,
      "choice": { "multiple": true, "freeSolo": true, "limitTags": 4 },
      "options": [
        { "value": "bestseller", "label": "Bestseller" },
        { "value": "eco", "label": "Eco friendly" },
        { "value": "sale", "label": "On sale" },
        { "value": "limited", "label": "Limited edition" }
      ]
    },
    {
      "name": "shippingRegions",
      "label": "Shipping Regions",
      "type": "checkboxGroup",
      "required": true,
      "choice": { "row": true, "maxSelected": 3 },
      "options": [
        { "value": "na", "label": "North America" },
        { "value": "eu", "label": "Europe" },
        { "value": "apac", "label": "Asia Pacific" },
        { "value": "latam", "label": "Latin America" }
      ]
    },
    {
      "name": "warrantyMonths",
      "label": "Warranty Period",
      "type": "slider",
      "required": false,
      "slider": { "min": 0, "max": 36, "step": 6, "marks": true, "unit": " mo" }
    },
    {
      "name": "isPublished",
      "label": "Publish immediately",
      "type": "switch",
      "required": false
    },
    {
      "name": "acceptTerms",
      "label": "I confirm this product complies with store policy",
      "type": "checkbox",
      "required": true
    },
    {
      "name": "category",
      "label": "Category",
      "type": "select",
      "required": true,
      "options": [
        { "value": "electronics", "label": "Electronics" },
        { "value": "clothing", "label": "Clothing" },
        { "value": "books", "label": "Books" },
        { "value": "home", "label": "Home & Garden" }
      ]
    }
  ],
  "onSubmit": "handleProductSubmit",
  "onError": "handleProductError"
}
