{
  "formId": "kyc_v2",
  "version": 2,
  "title": "Identity verification",
  "submitLabel": "Submit for review",
  "fields": [
    {
      "name": "legalName",
      "type": "text",
      "label": "Legal name",
      "helperText": "Exactly as it appears on your ID.",
      "rules": ["required", { "name": "minLength", "value": 3 }]
    },
    {
      "name": "email",
      "type": "email",
      "label": "Email",
      "rules": ["required", "email"]
    },
    {
      "name": "phone",
      "type": "phone",
      "rules": ["required"]
    },
    {
      "name": "idType",
      "type": "segmented",
      "label": "Document type",
      "options": [
        { "key": "passport", "label": "Passport" },
        { "key": "license", "label": "License" },
        { "key": "national", "label": "National ID" }
      ],
      "defaultValue": "passport"
    },
    {
      "name": "idNumber",
      "type": "text",
      "label": "Document number",
      "rules": ["required", { "name": "minLength", "value": 6 }]
    },
    {
      "name": "sourceOfFunds",
      "type": "chips",
      "label": "Source of funds",
      "options": [
        { "key": "salary", "label": "Salary" },
        { "key": "business", "label": "Business" },
        { "key": "investments", "label": "Investments" },
        { "key": "other", "label": "Other" }
      ]
    },
    {
      "name": "annualIncomeMinor",
      "type": "currency",
      "label": "Annual income",
      "helperText": "Used only for regulatory reporting."
    }
  ]
}
