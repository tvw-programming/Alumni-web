{
  "$comment": "A pre-visit intake schema. progressIsReliable is false because branching changes the number of questions — so no misleading 'Step 3 of 7' is shown.",
  "id": "pre-visit-intake",
  "version": "4.2.0",
  "title": "Before your appointment",
  "progressIsReliable": false,
  "privacyNote": "Your answers are added to your medical record and shared only with the clinicians involved in your care.",
  "sections": [
    {
      "id": "reason",
      "title": "Why are you being seen?",
      "description": "This helps your clinician prepare before you meet.",
      "questions": [
        {
          "id": "visitReason",
          "type": "longText",
          "label": "In your own words, what would you like help with today?",
          "required": true,
          "placeholder": "For example: a rash on my arm that has not improved",
          "validation": [{ "type": "minLength", "value": 5, "message": "Please add a little more detail" }]
        },
        {
          "id": "duration",
          "type": "singleSelect",
          "label": "How long has this been going on?",
          "required": true,
          "options": [
            { "id": "days", "label": "A few days" },
            { "id": "weeks", "label": "A few weeks" },
            { "id": "months", "label": "Several months" },
            { "id": "unsure", "label": "I'm not sure", "isEscapeAnswer": true }
          ]
        },
        {
          "id": "redFlags",
          "type": "multiSelect",
          "label": "Are you having any of these right now?",
          "helpText": "Select all that apply.",
          "required": true,
          "urgentIf": { "includes": "chestPain" },
          "options": [
            { "id": "chestPain", "label": "Chest pain or pressure" },
            { "id": "breathless", "label": "Difficulty breathing" },
            { "id": "bleeding", "label": "Bleeding that will not stop" },
            { "id": "none", "label": "None of these", "isEscapeAnswer": true }
          ]
        }
      ]
    },
    {
      "id": "medications",
      "title": "Medications and allergies",
      "questions": [
        {
          "id": "takingMedication",
          "type": "singleSelect",
          "label": "Are you currently taking any medication?",
          "required": true,
          "options": [
            { "id": "yes", "label": "Yes" },
            { "id": "no", "label": "No" },
            { "id": "unsure", "label": "I'm not sure", "isEscapeAnswer": true }
          ]
        },
        {
          "id": "medicationList",
          "type": "longText",
          "label": "Which medications are you taking?",
          "helpText": "Include the name and dose if you know it. An approximate list is fine.",
          "visibility": [{ "questionId": "takingMedication", "equals": "yes" }],
          "required": true
        },
        {
          "id": "allergies",
          "type": "multiSelect",
          "label": "Do you have any allergies?",
          "required": true,
          "options": [
            { "id": "penicillin", "label": "Penicillin" },
            { "id": "sulfa", "label": "Sulfa drugs" },
            { "id": "nsaids", "label": "Ibuprofen or aspirin" },
            { "id": "latex", "label": "Latex" },
            { "id": "food", "label": "A food allergy" },
            { "id": "none", "label": "No known allergies", "isEscapeAnswer": true },
            { "id": "unsure", "label": "I'm not sure", "isEscapeAnswer": true }
          ]
        }
      ]
    },
    {
      "id": "history",
      "title": "A little about you",
      "questions": [
        {
          "id": "heightCm",
          "type": "number",
          "label": "Your height",
          "unit": "cm",
          "validation": [
            { "type": "min", "value": 40, "message": "Please check this value" },
            { "type": "max", "value": 250, "message": "Please check this value" }
          ]
        },
        {
          "id": "weightKg",
          "type": "number",
          "label": "Your weight",
          "unit": "kg",
          "validation": [
            { "type": "min", "value": 2, "message": "Please check this value" },
            { "type": "max", "value": 400, "message": "Please check this value" }
          ]
        },
        {
          "id": "smoking",
          "type": "singleSelect",
          "label": "Do you smoke?",
          "options": [
            { "id": "never", "label": "Never" },
            { "id": "former", "label": "I used to" },
            { "id": "current", "label": "Yes, currently" },
            { "id": "declined", "label": "Prefer not to answer", "isEscapeAnswer": true }
          ]
        }
      ]
    }
  ]
}
