{
  "$comment": "Each state is supplied by the caller from the server's answer — the component never infers success from a tap.",
  "states": [
    { "state": "idle", "itemLabel": "Aurora Running Shoes", "note": "Default" },
    { "state": "loading", "itemLabel": "Aurora Running Shoes", "note": "Cart mutation in flight" },
    { "state": "added", "itemLabel": "Aurora Running Shoes", "note": "Confirmed by the server", "quantity": { "value": 1, "min": 1, "max": 5, "step": 1 } },
    { "state": "chooseOptions", "itemLabel": "Aurora Running Shoes", "note": "Size is required — opens the variant selector" },
    { "state": "outOfStock", "itemLabel": "Limited Edition Print", "note": "Offers notify-me instead of a dead button" },
    { "state": "error", "itemLabel": "Aurora Running Shoes", "errorMessage": "This item just went out of stock in your size.", "note": "Preserves context, offers retry" },
    { "state": "disabled", "itemLabel": "Regulated Item", "note": "Cannot ship to this address" }
  ]
}
