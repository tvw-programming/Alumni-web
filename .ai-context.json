{
  "monorepo": {
    "name": "CodeGen",
    "description": "Unified AI platform with multiple services and UIs"
  },
  "projects": [
    {
      "name": "core-backend",
      "path": "core/backend/",
      "description": "24-step AI workflow engine — pipeline runner, two human gates, gate API and CLI",
      "key-files": [
        "core/backend/src/codegen_core/orchestrator/runner.py",
        "core/backend/src/codegen_core/steps/",
        "core/backend/src/codegen_core/core/config.py",
        "core/backend/src/codegen_core/dashboard/api.py",
        "core/backend/src/codegen_core/tools/file_write_guard.py",
        "core/backend/config/config.json",
        "core/backend/pyproject.toml"
      ],
      "language": "python",
      "ignore": ["__pycache__", "artifacts", "runs", "workspace", ".venv"]
    },
    {
      "name": "core-frontend",
      "path": "core/frontend/",
      "description": "Run monitor dashboard — React 19 + MUI, reads the core-backend gate API",
      "key-files": [
        "core/frontend/src/App.tsx",
        "core/frontend/src/api/httpApi.ts",
        "core/frontend/src/api/mockApi.ts",
        "core/frontend/src/types/workflow.ts",
        "core/frontend/src/pages/DashboardPage.tsx",
        "core/frontend/package.json"
      ],
      "language": "typescript",
      "ignore": ["node_modules", "dist", "dist-smoke"]
    },
    {
      "name": "react-components",
      "path": "libraries/react-components/",
      "description": "Reusable React component library",
      "key-files": [
        "src/components/",
        "src/hooks/",
        "src/types/index.ts",
        "package.json"
      ],
      "language": "javascript",
      "ignore": ["node_modules", "dist"]
    },
    {
      "name": "python-explainer",
      "path": "services/python-explainer/",
      "description": "Convert Python code to video",
      "key-files": [
        "src/main.py",
        "src/video_generator.py",
        "requirements.txt"
      ],
      "language": "python",
      "ignore": ["__pycache__", "venv"]
    },
    {
      "name": "react-web",
      "path": "apps/react-web/",
      "description": "Main React UI for workflow",
      "key-files": [
        "src/App.tsx",
        "src/components/",
        "src/pages/",
        "package.json"
      ],
      "language": "javascript",
      "ignore": ["node_modules", "dist"]
    }
  ],
  "shared": [
    "packages/shared-types/src/index.ts",
    "packages/design-tokens/index.ts",
    "packages/shared-utils/src/"
  ],
  "ignore-globally": [
    "node_modules",
    "dist",
    "build",
    ".git",
    "__pycache__",
    ".venv",
    "venv"
  ]
}
