{
  "monorepo": {
    "name": "alumni-web",
    "description": "Alumni management sample app — React (Vite) UI, Go Fiber gateway, PostgreSQL"
  },
  "projects": [
    {
      "name": "alumni-web",
      "path": ".",
      "description": "React 19 + MUI admin, profile and gallery screens, backed by fixture data or the gateway",
      "key-files": [
        "src/main.tsx",
        "src/App.tsx",
        "src/api/alumni.ts",
        "src/features/admin/AlumniAdminGrid.tsx",
        "src/features/alumni/ProfilePage.tsx",
        "src/features/media/MediaGallery.tsx",
        "vite.config.ts",
        "package.json"
      ],
      "language": "typescript",
      "ignore": ["node_modules", "dist"]
    },
    {
      "name": "alumni-api",
      "path": "api/",
      "description": "Go Fiber gateway — alumni CRUD over PostgreSQL with raw SQL",
      "key-files": [
        "api/cmd/server/main.go",
        "api/internal/handler/alumni_handler.go",
        "api/internal/repository/alumni_repository.go",
        "db/migrations/",
        "db/queries/alumni.sql"
      ],
      "language": "go",
      "ignore": ["bin"]
    }
  ],
  "shared": [],
  "ignore-globally": [
    "node_modules",
    "dist",
    ".git",
    "__pycache__",
    ".venv",
    "venv",
    "vendor/react-components"
  ]
}
