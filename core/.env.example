# Copy to .env — run.sh does this for you on first start.
# Everything here has a working default; nothing is required.

# --- where things listen ---------------------------------------------------
CODEGEN_FRONTEND_PORT=5173
CODEGEN_API_PORT=8000

# --- which story to run ----------------------------------------------------
# Any .md file in ./stories, by its key.
CODEGEN_STORY=DEEP-2041

# --- models ----------------------------------------------------------------
# docker         mocked models. No keys, no network, no cost. The default.
# docker-ollama  models on your Mac via Ollama at host.docker.internal:11434.
#                Pull them first:  ollama pull qwen2.5-coder:32b
#                                  ollama pull deepseek-r1:32b
# docker-cloud   the paid tier. Needs the keys below.
CODEGEN_PROFILE=docker

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- startup behaviour -----------------------------------------------------
# Nothing starts on its own. Press "Start a run" in the dashboard, or run
# `make run-story`. Set this to 1 to bring back the old auto-seed-on-boot demo.
CODEGEN_SEED_RUN=0
# Where a seeded run stops, when CODEGEN_SEED_RUN=1. 5 leaves it at the BRD gate.
CODEGEN_SEED_STOP=5
# How often the watcher checks for a decision made in the browser.
CODEGEN_WATCH_INTERVAL=3

# --- architecture ----------------------------------------------------------
# linux/arm64 on Apple Silicon. Set linux/amd64 on an Intel Mac or CI runner.
CODEGEN_PLATFORM=linux/arm64

# dev serves the Vite dev server with hot reload; prod builds static assets
# and serves them through nginx.
CODEGEN_FRONTEND_TARGET=dev
