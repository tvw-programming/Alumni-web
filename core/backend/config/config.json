      "model": "anthropic.claude-sonnet-4-v1:0",
      "region": "${env:AWS_REGION:-ap-south-1}",
      "auth": {
        "type": "aws_profile",
        "profile_env": "AWS_PROFILE"
      },
      "capabilities": [
        "coding",
        "reasoning",
        "security",
        "vision"
      ],
      "params": {
        "temperature": 0.0,
        "max_tokens": 16384
      },
      "limits": {
        "timeout_s": 600,
        "rpm": 60
      },
      "cost_per_1k_usd": {
        "input": 0.003,
        "output": 0.015
      },
      "enabled": true
    },
