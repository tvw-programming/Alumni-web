  "artifacts": {
    "naming_template": "{step:02d}_{slug}{variant_suffix}__{job_id}__v{version}.{ext}",
    "variant_suffix_template": "__{variant}",
    "extension_rules": {
      "structured": [
        "json",
        "diff"
      ],
      "document": [
        "pdf",
        "docx"
      ],
      "error_snapshot": "jpg",
      "specification": "md"
    },
    "checksum_algorithm": "sha256",
    "immutable": true,
    "versioning": "increment_on_retry",
    "index_file": "index.json"
  },
  "policy": {
    "write_scope": {
      "source": "step_09.allowed_paths",
      "deny_globs": [
        "**/.github/workflows/**",
        "**/secrets/**",
        "**/*.pem",
        "**/*.key",
        "**/.env*"
      ],
      "max_changed_files": 40,
      "max_changed_loc": 800,
      "migrations_require_human_signoff": true
    },
    "non_invention": {
      "on_ambiguity": "halt_and_ticket",
      "hallucination_detector_step": 13,
      "forbid_requirement_synthesis": true
    },
    "quality_thresholds": {
      "min_line_coverage_pct": 80,
      "min_changed_line_coverage_pct": 90,
      "max_cyclomatic_complexity": 12,
      "block_on_severity": [
        "CRITICAL",
        "HIGH"
      ]
    },
    "forbidden_dependencies": [
      "pycrypto",
      "requests<2.31"
    ],
    "override": {
      "allowed_roles": [
        "security_owner"
      ],
      "requires_justification": true,
      "audited": true
    }
  },
  "gates": {
    "06": {
      "name": "BRD Approval",
      "required_roles": [
        "product_owner"
      ],
      "quorum": 1,
      "bind_to_artifact_sha": true,
      "reminder_after_hours": 24,
      "escalate_after_hours": 72,
      "escalate_to": [
        "engineering_manager"
      ],
      "can_disable": false,
      "revision": {
        "enabled": true,
        "replaces_step": 5,
        "slug": "brd",
        "variant": "revised",
        "schema_id": "BrdV1",
        "accepted_extensions": [
          "md",
          "pdf",
          "docx"
        ],
        "max_bytes": 10485760,
        "max_revisions": 3
      }
    },
    "24": {
      "name": "PR Approval & Merge",
      "required_roles": [
        "senior_engineer"
      ],
      "quorum": 1,
      "bind_to_artifact_sha": true,
      "block_if_open_findings": true,
      "reminder_after_hours": 12,
      "escalate_after_hours": 48,
      "escalate_to": [
        "engineering_manager"
      ],
      "can_disable": false
    }
  },
  "plugins": {
    "tracker": {
      "driver": "jira",
      "base_url": "${env:JIRA_URL:-}",
      "auth": {
        "type": "api_token",
        "user_env": "JIRA_USER",
        "token_env": "JIRA_TOKEN"
      },
      "project_key": "DEEP"
    },
    "vcs": {
      "driver": "github",
      "base_url": "https://api.github.com",
      "auth": {
        "type": "api_token",
        "token_env": "GITHUB_TOKEN"
      },
      "repo": "${env:TARGET_REPO:-}",
      "branch_template": "codegen/{jira_id}-{slug}",
      "draft_pr": true
    },
    "test_runner": {
      "driver": "pytest",
      "command": [
        "pytest",
        "-q",
        "--json-report",
        "--cov"
      ],
      "coverage_format": "cobertura"
    },
    "e2e_runner": {
      "driver": "playwright",
      "command": [
        "npx",
        "playwright",
        "test",
        "--reporter=json"
      ],
      "screenshot_on_failure": true,
      "ephemeral_env": {
        "enabled": true,
        "compose_file": "docker-compose.test.yml",
        "teardown": true
      }
    },
    "sast": {
      "driver": "semgrep",
      "command": [
        "semgrep",
        "--config",
        "auto",
        "--json"
      ]
    },
    "sca": {
      "driver": "trivy",
      "command": [
        "trivy",
        "fs",
        "--format",
        "json",
        "."
      ]
    },
    "secrets": {
      "driver": "gitleaks",
      "command": [
        "gitleaks",
        "detect",
        "--report-format",
        "json"
      ]
    },
    "dast": {
      "driver": "zap",
      "target_url": "${env:STAGING_URL:-}",
      "auth_scenario": "authenticated_user",
      "rules": "owasp-top-10"
    },
    "notifier": {
      "driver": "slack",
      "webhook_env": "SLACK_WEBHOOK",
      "notify_on": [
        "gate_opened",
        "gate_timeout",
        "pipeline_halted",
        "budget_exceeded"
      ]
    },
    "dashboard": {
      "driver": "fastapi",
      "host": "0.0.0.0",
      "port": 8080,
      "auth": {
        "type": "oidc",
        "issuer_env": "OIDC_ISSUER"
      }
    }
  },
  "observability": {
    "log_level": "INFO",
    "log_format": "json",
    "metrics_sink": {
      "driver": "prometheus",
      "port": 9090
    },
    "trace_sink": {
      "driver": "otlp",
      "endpoint_env": "OTEL_ENDPOINT",
      "enabled": false
    },
    "emit_per_step": [
      "latency_s",
      "tokens_in",
      "tokens_out",
      "cost_usd",
      "status",
      "retry_count"
    ],
    "alerts": {
      "step_failure_rate_pct": 20,
      "job_duration_minutes": 180,
      "cost_overrun_pct": 120
    }
  },
  "secrets": {
    "provider": "env",
    "vault": {
      "enabled": false,
      "address_env": "VAULT_ADDR",
      "mount": "codegen-core"
    },
    "redaction": {
      "scrub_pii_from_prompts": true,
      "patterns": [
        "(?i)api[_-]?key",
        "(?i)authorization:\\s*bearer\\s+\\S+",
        "sk-[A-Za-z0-9]{20,}",
        "ghp_[A-Za-z0-9]{20,}"
      ],
      "never_persist_in": [
        "artifacts",
        "runs"
      ]
    },
    "reject_literal_secrets_in_config": true
  },
  "visualization": {
    "default_variant": "logistics",
    "variants": {
      "logistics": {
        "label": "Logistics",
        "kicker": "INTELLIGENT FREIGHT CORRIDOR",
        "headline": "Every release arrives on time",
        "route_label": "FREIGHT ROUTE",
        "vehicle": "truck",
        "motion": "speed-route",
        "palette": {
          "accent": "#55b8ff",
          "accent_bright": "#dff3ff",
          "accent_soft": "#173347",
          "secondary": "#ff9f43",
          "completed": "#55b8ff",
          "muted": "#576d7b",
          "surface": "#09151d",
          "surface_active": "#17384d",
          "surface_completed": "#123045",
          "surface_upcoming": "#101b22",
          "pattern": "linear-gradient(90deg, transparent 48%, rgba(85,184,255,.045) 49%, rgba(85,184,255,.045) 51%, transparent 52%)"
        }
      }
    }
