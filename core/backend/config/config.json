        "coding"
      ],
      "params": {
        "temperature": 0.0,
        "num_ctx": 65536
      },
      "limits": {
        "timeout_s": 900,
        "max_tokens": 16384
      },
      "cost_per_1k_usd": {
        "input": 0.0,
        "output": 0.0
      },
      "enabled": true
    },
    "cloud.bedrock.sonnet": {
