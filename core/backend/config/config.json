    "devtool.cursor": {
      "driver": "cli_agent",
      "tier": "dev_tool",
      "command": "cursor-agent",
      "argv": [
        "--headless",
        "--json",
        "--cwd",
        "{workspace}",
        "-p",
        "{prompt}"
      ],
      "model": "cursor:auto",
      "result_json_path": "$.result",
      "edits_files_directly": true,
      "capabilities": [
        "coding"
      ],
      "limits": {
        "timeout_s": 900
      },
      "cost_per_1k_usd": {
        "input": 0.0,
        "output": 0.0
      },
      "enabled": false
    },
    "devtool.copilot": {
      "driver": "cli_agent",
      "tier": "dev_tool",
      "command": "gh",
      "argv": [
        "copilot",
        "suggest",
        "--target",
        "shell",
        "-p",
        "{prompt}"
      ],
      "model": "copilot:default",
      "result_json_path": null,
      "edits_files_directly": false,
      "capabilities": [
        "coding"
      ],
      "limits": {
        "timeout_s": 300
      },
      "enabled": false
    },
    "devtool.claude_code": {
