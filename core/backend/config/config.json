{
  "$schema": "./config.schema.json",
  "version": "1.0.0",
  "default_profile": "local",
  "app": {
    "job_id_prefix": "DEEP",
    "paths": {
      "artifacts": "./artifacts/{job_id}",
      "runs": "./runs/{job_id}",
      "workspace": "./workspace/{job_id}",
      "prompts": "./config/prompts",
      "schema_registry": "./config/schemas"
    },
    "project": {
      "path": "",
      "must_exist": true,
      "must_be_writable": true
    },
    "retention_days": {
      "artifacts": 180,
      "journal": 730,
      "workspace": 2
    },
    "concurrency": {
      "max_parallel_steps": 3,
      "max_parallel_llm_calls": 4
    }
  },
  "a2a": {
    "protocol": "a2a/1.0",
    "transport": "in_process",
    "inline_payload_limit_bytes": 65536,
    "strict_schema_validation": true,
    "adapters": {
      "image/jpeg->text/plain": {
        "enabled": true,
        "driver": "vision_caption",
        "capability": "vision"
      },
      "image/png->text/plain": {
        "enabled": true,
        "driver": "vision_caption",
        "capability": "vision"
      },
      "application/pdf->text/markdown": {
        "enabled": true,
        "driver": "pymupdf"
      },
      "application/json->text/plain": {
        "enabled": true,
        "driver": "pretty_print"
      },
      "text/x-diff->application/json": {
        "enabled": true,
        "driver": "unidiff"
      }
    }
  },
  "backends": {
    "local.ollama.qwen": {
      "driver": "ollama",
      "tier": "local",
      "model": "qwen3:8b",
      "base_url": "${env:OLLAMA_HOST:-http://localhost:11434}",
      "capabilities": [
        "fast"
      ],
      "params": {
        "temperature": 0.0,
        "num_ctx": 32768
      },
      "limits": {
        "timeout_s": 300,
        "max_tokens": 8192,
        "rpm": 0
      },
      "cost_per_1k_usd": {
        "input": 0.0,
        "output": 0.0
      },
      "health_check": {
        "type": "http",
        "path": "/api/tags"
      },
      "enabled": true
    },
    "local.ollama.deepseek": {
      "driver": "ollama",
