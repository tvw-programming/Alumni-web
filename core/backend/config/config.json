        "--output-format",
        "json",
        "--cwd",
        "{workspace}"
      ],
      "model": "claude-code",
      "result_json_path": "$.result",
      "edits_files_directly": true,
      "capabilities": [
        "coding"
      ],
      "limits": {
        "timeout_s": 1800
