  "routing": {
    "defaults": {
      "fast": "local.ollama.qwen",
      "coding": "paid.anthropic.sonnet",
      "reasoning": "paid.anthropic.opus",
      "security": "cloud.bedrock.sonnet",
      "vision": "paid.openai.gpt"
    },
    "fallback_chains": {
      "fast": [
        "local.ollama.qwen",
        "cloud.together.llama",
        "paid.openai.gpt"
      ],
      "coding": [
        "paid.anthropic.sonnet",
        "cloud.bedrock.sonnet",
        "local.ollama.deepseek"
      ],
      "reasoning": [
        "paid.anthropic.opus",
        "cloud.bedrock.sonnet",
        "paid.openai.gpt"
      ],
      "security": [
        "cloud.bedrock.sonnet",
        "paid.anthropic.opus"
      ],
      "vision": [
        "paid.openai.gpt",
        "cloud.bedrock.sonnet"
      ]
    },
    "steps": {
      "01": {
        "capability": "fast"
      },
      "02": {
        "capability": "reasoning"
      },
      "03": {
        "capability": "reasoning",
        "params": {
          "temperature": 0.0
        }
      },
      "04": {
        "capability": "reasoning"
      },
      "05": {
        "capability": "reasoning"
      },
      "07": {
        "capability": "reasoning"
      },
      "08": {
        "capability": "coding"
      },
      "09": {
        "capability": "coding"
      },
      "10": {
        "capability": "reasoning"
      },
      "11": {
        "capability": "coding"
      },
      "12": {
        "capability": "coding"
      },
      "13": {
        "capability": "reasoning"
      },
      "15": {
        "capability": "coding"
      },
      "19": {
        "capability": "security"
      },
      "20": {
        "capability": "reasoning"
      },
      "21": {
        "capability": "coding"
      },
      "23": {
        "capability": "reasoning"
      },
      "24": {
        "capability": "fast"
      }
    },
    "isolation": [
      {
        "rule_id": "no_self_review",
        "reviewer_steps": [
          13,
          23
        ],
        "must_differ_from": [
          12,
          15
        ],
        "scope": "model_and_context",
        "on_violation": "use_fallback"
      }
    ],
    "budgets": {
      "per_job_usd": 12.0,
      "per_step_usd": 3.0,
      "per_step_tokens": 250000,
      "on_exceed": "halt_and_notify"
    }
  },
    "pipeline": {
    "start_step": 1,
    "stop_step": 24,
    "max_parallel_steps": 3,
    "parallel_groups": [
      [7, 8],
      [18, 19],
      [20, 21]
    ],
    "remediation_edges": [
      {
        "from": 7,
        "on": "FAILED",
        "to": 7,
        "max_loops": 2
      },
      {
        "from": 13,
        "on": "FAILED",
        "to": 12,
        "max_loops": 3
      },
      {
        "from": 14,
        "on": "FAILED",
        "to": 12,
        "max_loops": 3
      },
      {
        "from": 17,
        "on": "FAILED",
        "to": 12,
        "max_loops": 3
      },
      {
        "from": 18,
        "on": "BLOCKING_FINDINGS",
        "to": 12,
        "max_loops": 2
      },
      {
        "from": 18,
        "on": "FAILED",
        "to": 12,
        "max_loops": 2
      },
      {
        "from": 19,
        "on": "BLOCKING_FINDINGS",
        "to": 12,
        "max_loops": 2
      },
      {
        "from": 19,
        "on": "FAILED",
        "to": 12,
        "max_loops": 2
      },
      {
        "from": 23,
        "on": "CHANGES_REQUESTED",
        "to": 12,
        "max_loops": 3
      },
      {
        "from": 24,
        "on": "CHANGES_REQUESTED",
        "to": 12,
        "max_loops": 5
      }
    ],
    "failure_class_routes": [
      {"class": "TEST", "to": 15, "max_loops": 1, "then": 12},
      {"class": "LINT", "to": 14, "max_loops": 2, "then": 12},
      {"class": "AMBIGUITY", "to": 2, "max_loops": 2, "then": null},
      {"class": "CODE", "to": 12, "max_loops": 3, "then": null},
      {"class": "SECURITY", "to": 12, "max_loops": 2, "then": null},
      {"class": "OTHER", "to": 12, "max_loops": 2, "then": null}
    ],
    "on_max_loops_exceeded": "halt_and_escalate"
  },
  "steps": {
    "01": {
      "enabled": true,
      "component": "plugin",
      "binding": "tracker",
      "timeout_s": 120,
      "retry": {
        "max_attempts": 3,
        "backoff_s": 5
      },
      "risk_level": "low",
      "allowed_actions": [
        "read"
