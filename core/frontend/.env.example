# Copy to .env. Leave both unset to run on the built-in mock — no backend required.

# Point the dashboard at a running backend:
#   cd ../backend && PYTHONPATH=src python -m codegen_core.dashboard.api
# VITE_API_BASE=http://127.0.0.1:8000

# Optional: pin a specific run. Defaults to the newest one on the server.
