{
  "name": "CodeGen",
  "version": "1.0.0",
  "description": "Unified AI workflow with multiple frontends and backends",
  "workspaces": [
    "packages/*",
    "apps/*",
    "libraries/*",
    "services/*/node_modules"
  ],
  "projects": {
    "core-backend": {
      "type": "python",
      "description": "24-step AI workflow engine: pipeline runner, gate API and CLI",
      "path": "core/backend/",
      "languages": ["python"],
      "entrypoints": {
        "api": "codegen_core.dashboard.api:create_app",
        "cli": "codegen_core.cli:main"
      },
      "port": 8000
    },
    "core-frontend": {
      "type": "react",
      "description": "Run monitor dashboard for the 24-step workflow",
      "path": "core/frontend/",
      "language": "javascript",
      "port": 5173
    },
    "react-components": {
      "type": "library",
      "description": "Reusable React components",
      "path": "libraries/react-components/",
      "language": "javascript"
    },
    "react-native-components": {
      "type": "library",
      "description": "Reusable React Native components across six domains",
      "path": "libraries/react-native-components/",
      "language": "typescript"
    },
    "python-explainer": {
      "type": "service",
      "description": "Python code to video",
      "path": "services/python-explainer/",
      "language": "python"
    },
    "react-web": {
      "type": "app",
      "description": "React UI for workflow",
      "path": "apps/react-web/",
      "language": "javascript"
    }
  },
  "shared": {
    "types": "packages/shared-types/",
    "utils": "packages/shared-utils/",
    "tokens": "packages/design-tokens/"
  }
}
