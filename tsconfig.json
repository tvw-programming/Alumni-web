{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Must mirror vite.config.ts exactly. `@/*` deliberately points into the
    // vendored library, not this app — its components resolve their own
    // imports through it. This app's own code is `~/*`.
    "paths": {
      "~/*": ["./src/*"],
      "@ui/*": ["./vendor/react-components/src/*"],
      "@/*": ["./vendor/react-components/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "vendor/react-components/src/global.d.ts"]
}
